---
import { getCollection } from "astro:content";
import Markdown from "@components/misc/Markdown.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const itineraryPage = (await getCollection("spec")).find(
	(entry) => entry.slug === "itinerary",
);

if (!itineraryPage) {
	throw new Error(
		"Missing itinerary content at src/content/spec/itinerary.md",
	);
}

const { Content } = await itineraryPage.render();
---

<MainGridLayout
	title="Itinerary"
	description="A table for planning the Australia trip itinerary."
>
	<section class="card-base px-6 pb-4 pt-6 md:px-9 onload-animation">
		<Markdown class="markdown-content onload-animation">
			<Content />
		</Markdown>
	</section>
</MainGridLayout>
